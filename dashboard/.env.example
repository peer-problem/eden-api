# Examples for the private .ops/.env; do not create a dashboard .env.
# Launchers choose the API in memory; no API URL override is needed here.
# .ops/client.sh uses https://api.edenapi.org through the development proxy.
# .ops/api_and_client.sh uses http://127.0.0.1:8000/v1 and the remote DB via SSH.

# Server-only settings. .ops/api_and_client.sh generates these in memory.
# EDEN_EXPLORER_UPSTREAM=http://127.0.0.1:8000
# EDEN_EXPLORER_TOKEN=match-the-local-api-token
